msgstr "B<editor> \\\\(voir B<editor>(1), B<update-alternatives>(1)"

#. type: Plain text
#: sensible-editor.man
msgid "B<nano>(1)"
msgstr "B<nano>(1)"

#. type: Plain text
#: sensible-editor.man
